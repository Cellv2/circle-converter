{
    "name": "circle-converter",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint .",
        "prepare": "husky",
        "prettier:check": "prettier . --check",
        "prettier:format": "prettier . --write",
        "preview": "vite preview",
        "test": "vitest",
        "test:ci": "vitest --run"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint"
        ],
        "*.{css,html,json,mjs}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    }
}
